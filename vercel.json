{
  "rewrites": [
    { "source": "/about",      "destination": "/about/index.html" },
    { "source": "/visitors",   "destination": "/visitors/index.html" },
    { "source": "/residents",  "destination": "/residents/index.html" },
    { "source": "/safe-smart", "destination": "/safe-smart/index.html" },
    { "source": "/contact",    "destination": "/contact/index.html" },
    { "source": "/(.*)",       "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag",   "value": "index, follow" },
        { "key": "Cache-Control",  "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type",  "value": "application/xml" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
