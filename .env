# Brevo (Sendinblue) API Key
# Get yours free at https://app.brevo.com → Settings → API Keys
VITE_BREVO_API_KEY=your_brevo_api_key_here

# The Brevo List ID to add subscribers to
# Find it at Contacts → Lists → click your list → the ID is in the URL
VITE_BREVO_LIST_ID=2

# Brevo Transactional Email API Key (for contact form)
# Same key as above, or create a dedicated one at Brevo → Settings → API Keys
VITE_BREVO_SMTP_KEY=your_brevo_api_key_here
